      "title": "CBD for Sleep in People With HIV",
      "status": "WITHDRAWN",
      "phases": [
        "PHASE2"
      ],
      "study_type": "INTERVENTIONAL",
      "conditions": [
        "Sleep Disturbance"
      ],
      "interventions": [
        "Cannabidiol oral solution",
        "Inert sesame seed oil"
      ],
      "sponsor": "Mariana Cherner, PhD",
      "enrollment": 0,
      "start_date": "2021-04-01",
      "completion_date": "2023-08-31",
      "summary": "This study will obtain preliminary information about whether, and at what dose, cannabidiol (CBD) may help with insomnia in people living with human immunodeficiency virus (HIV). The study will be a 5-week randomized, double-blind placebo-controlled phase II trial using daily oral CBD doses between 50mg and 600mg. Sleep problems will be measured using a wrist-worn device and by self-report. Performance on tests of thinking skills will be compared before and after CBD/placebo treatment. Positive study results will provide support for the use of CBD as a potential treatment for insomnia.",
      "url": "https://clinicaltrials.gov/study/NCT05097651",
      "molecule": "Cannabidiol",
